set_option maxRecDepth 4096 in
theorem arithmeticCells_endpoint : arithmeticChainEnd (1 / 40) arithmeticCells = 9 / 20 := by rfl

set_option maxRecDepth 4096 in
set_option maxHeartbeats 4000000 in
theorem arithmeticCells_area_sum : (arithmeticCells.map ArithmeticCell.area).sum = middleArea := by

  have h : (arithmeticCells.map ArithmeticCell.area).sum = middleAreaBlock00 + middleAreaBlock01 + middleAreaBlock02 + middleAreaBlock03 + middleAreaBlock04 + middleAreaBlock05 + middleAreaBlock06 + middleAreaBlock07 + middleAreaBlock08 + middleAreaBlock09 + middleAreaBlock10 + middleAreaBlock11 + middleAreaBlock12 + middleAreaBlock13 + middleAreaBlock14 := by

    simp only [arithmeticCells, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil]

    unfold middleAreaBlock00 middleAreaBlock01 middleAreaBlock02 middleAreaBlock03 middleAreaBlock04 middleAreaBlock05 middleAreaBlock06 middleAreaBlock07 middleAreaBlock08 middleAreaBlock09 middleAreaBlock10 middleAreaBlock11 middleAreaBlock12 middleAreaBlock13 middleAreaBlock14

    ring
  exact h.trans middleArea_blocks


theorem middleRankProfile_integrable :
    IntervalIntegrable middleRankProfile MeasureTheory.volume (1 / 40 : ℝ) (9 / 20 : ℝ) := by
  have h := (integrate_arithmeticChain arithmeticCells_chain).1
  rw [arithmeticCells_endpoint] at h
  norm_num at h ⊢
  exact h

theorem middleRankProfile_integral :
    (∫ β in (1 / 40 : ℝ)..(9 / 20 : ℝ), middleRankProfile β) = (middleArea : ℝ) := by
  have h := (integrate_arithmeticChain arithmeticCells_chain).2
  rw [arithmeticCells_endpoint, arithmeticCells_area_sum] at h
  norm_num at h ⊢
  exact h

